---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getEvents } from '../data/getEvents.js';

const events = await getEvents();
---

<BaseLayout title="Mød andre kreative" description="Kreativt fællesskab i København med events og workshops">
<section class="hero">
 <div class="container hero-grid">
  <div>
   <div class="eyebrow">
    Kreativt fællesskab i København ✳
   </div>
   <h1>
    Mød andre
    <br/>
    kreative.
   </h1>
   <p>
    Del idéer. Få ny inspiration. Mød mennesker, der også brænder for design. Her er der plads til alle kreative.
   </p>
   <a class="btn btn-yellow" href="/events/">
    Se kommende events ↗
   </a>
  </div>
  <div class="hero-visual">
   <span aria-hidden="true" class="spark">
    ✳
   </span>
   <span class="sticker blue">
    CREATE
    <br/>
    CONNECT
    <br/>
    SHARE
   </span>
   <img alt="Venner samlet i et kreativt fællesskab" src="/images/hero-community.png"/>
   <span class="sticker yellow">
    KREATIVITET
    <br/>
    FOR ALLE ✳
   </span>
  </div>
 </div>
</section>
<section class="section" id="events">
 <div class="container">
  <div class="section-heading">
   <div>
    <div class="eyebrow">
     Det sker hos os
    </div>
    <h2>
     Kommende events
    </h2>
    <p class="section-intro">
     Foredrag, workshops og hyggelige møder. Find dit næste kreative fællesskab.
    </p>
   </div>
   <a class="btn btn-plain" href="/events/">
    Se alle events ↗
   </a>
  </div>
  <div class="event-grid">
  {events.map((event) => <EventCard event={event} />)}
</div>
  <div class="center">
   <a class="btn btn-dark" href="/events/">
    Udforsk alle events ↗
   </a>
  </div>
 </div>
</section>
<section class="about-banner">
 <div class="container about-inner">
  <div>
   <div class="eyebrow">
    Om KindDesign CPH
   </div>
   <h2>
    Et kreativt fællesskab for alle
   </h2>
   <p>
    KindDesign CPH samler kreative mennesker i København. Vi tror på, at de bedste idéer opstår, når vi mødes, lærer af hinanden og giver plads til nye perspektiver.
   </p>
   <p>
    Her handler det ikke om at være perfekt – men om at skabe, eksperimentere og høre til.
   </p>
   <a class="btn btn-dark" href="/om-os/">
    Lær os at kende ↗
   </a>
  </div>
  <img alt="Kreative mennesker samarbejder omkring et bord" src="/images/friends-group.png"/>
 </div>
</section>
<section class="section">
 <div class="container">
  <div class="section-heading">
   <div>
    <div class="eyebrow">
     Hvorfor være med?
    </div>
    <h2>
     Skab noget sammen
    </h2>
   </div>
  </div>
  <div class="feature-row">
   <article class="feature">
    <div class="feature-symbol">
     ✳
    </div>
    <h3>
     Mød nye mennesker
    </h3>
    <p>
     Find andre, der deler din interesse for design, kreativitet og gode idéer.
    </p>
   </article>
   <article class="feature">
    <div class="feature-symbol">
     ↗
    </div>
    <h3>
     Bliv inspireret
    </h3>
    <p>
     Få nye perspektiver gennem samtaler, events, oplæg og workshops.
    </p>
   </article>
   <article class="feature">
    <div class="feature-symbol">
     ✦
    </div>
    <h3>
     Vær en del af noget
    </h3>
    <p>
     Et åbent og inkluderende fællesskab med plads til at være dig selv.
    </p>
   </article>
  </div>
 </div>
</section>
<section class="cta-band">
 <div class="eyebrow">
  Vi ses snart!
 </div>
 <h2>
  Din næste idé starter med et møde.
 </h2>
 <p>
  Find et event, du har lyst til at være med til.
 </p>
 <a class="btn btn-yellow" href="/events/">
  Find dit næste event ↗
 </a>
</section>

</BaseLayout>
